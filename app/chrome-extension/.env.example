# Optional. Builds use the fork's public key from wxt.config.ts by default
# (extension id ifjjgkpcpjfkfomkpbnkhhblnfgejono), so most people need nothing here.
# Set this only to build with another id, e.g. the upstream one to keep an existing install's settings.
# CHROME_EXTENSION_KEY=<base64 public key>
